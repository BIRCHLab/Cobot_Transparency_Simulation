<mujoco model="ur5e">
  <compiler angle="radian" meshdir="assets" autolimits="true" />

  <option integrator="implicitfast" gravity='0 0 0'/>

  <default>
    <default class="ur5e">
      <material specular="0.5" shininess="0.25"/>
      <!-- <joint axis="0 1 0" range="-6.28319 6.28319" armature="0.1"/>
      <general gaintype="fixed" biastype="none" ctrlrange="-150 150" forcerange="-150 150"/> -->
      
      <joint axis="0 1 0" range="-6.28319 6.28319" armature="0.652996613" damping = "5.0"/>

      <general gaintype="fixed" biastype="none" ctrlrange="-1.48519 1.48519" forcerange="-150 150" forcelimited='true' gear="101"/>
      <default class="size3">
        <default class="size3_limited">
          <joint range="-3.1415 3.1415" armature="0.122738432"/>
          <general ctrlrange="-1.48519 1.48519" forcerange="-150 150" forcelimited='true' gear="101"/>
        </default>
      </default>

      <default class="size1">
        <general forcerange="-28 28" ctrlrange="-0.277228 0.277228" gear="101"/>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom type="capsule" group="0"/>
        <default class="eef_collision">
          <geom type="cylinder"/>
        </default>
      </default>
      <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="0"/>
    </default>
  </default>

  <visual>
    <global offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <material class="ur5e" name="black" rgba="0.033 0.033 0.033 1"/>
    <material class="ur5e" name="jointgray" rgba="0.278 0.278 0.278 1"/>
    <material class="ur5e" name="linkgray" rgba="0.82 0.82 0.82 1"/>
    <material class="ur5e" name="urblue" rgba="0.49 0.678 0.8 1"/>

    <mesh file="base_0.obj"/>
    <mesh file="base_1.obj"/>
    <mesh file="shoulder_0.obj"/>
    <mesh file="shoulder_1.obj"/>
    <mesh file="shoulder_2.obj"/>
    <mesh file="upperarm_0.obj"/>
    <mesh file="upperarm_1.obj"/>
    <mesh file="upperarm_2.obj"/>
    <mesh file="upperarm_3.obj"/>
    <mesh file="forearm_0.obj"/>
    <mesh file="forearm_1.obj"/>
    <mesh file="forearm_2.obj"/>
    <mesh file="forearm_3.obj"/>
    <mesh file="wrist1_0.obj"/>
    <mesh file="wrist1_1.obj"/>
    <mesh file="wrist1_2.obj"/>
    <mesh file="wrist2_0.obj"/>
    <mesh file="wrist2_1.obj"/>
    <mesh file="wrist2_2.obj"/>
    <mesh file="wrist3.obj"/>
  </asset>

  <worldbody>
    <camera name="isometric" pos="-1.762 0.029 1.182" xyaxes="-0.230 -0.973 0.000 0.460 -0.109 0.881"/>

    <light name="spotlight" mode="targetbodycom" target="wrist_2_link" pos="0 -1 4"/>

    <geom name="floor" type="plane" size="5 5 0.1" pos="0 0 -0.5" rgba="1 1 1 1" friction="1 0.005 0.0001"/>
    <geom name="wall" type="box" size="0.1 2 2" pos="1 0 1" rgba="1 1 1 1" friction="1 0.005 0.0001"/>
    <geom name="pedestal" type='cylinder' fromto='0 0 0 0 0 -0.5' size='.1' rgba="1 1 1 1"/>

    <body name="base" quat="1 0 0 0" childclass="ur5e">
      <inertial mass="4.0" pos="0 0 0" diaginertia="0.00443333156 0.00443333156 0.0072" quat="0 0 0 1"/>

      <!-- <inertial mass="4.0" pos="0 0 0" diaginertia="0.0072 0.00443333156 0.00443333156"/> -->
      <!-- <inertial mass="4.0" pos="0 0 0" diaginertia="0.00443333156 0.00443333156 0.0072" quat="0 0 0 1"/> -->
      <!-- <site name="frame0" pos="0 0 0" size="0.003" rgba='1 0 0 1' group='0'/> -->

      <geom name="base_0" mesh="base_0" material="black" class="visual" quat="0 0 0 1"/>
      <geom name="base_1" mesh="base_1" material="jointgray" class="visual" quat="0 0 0 1"/>
      <geom name="manipulability_ellipsoid" size='.1 .2 .3' rgba='1 0 0 0' mass = '0' conaffinity="0" contype="0"/>
      <geom name="manipulability_ellipsoid2" size='.1 .2 .3' rgba='1 0 0 0' mass = '0' conaffinity="0" contype="0"/>


      <body name="shoulder_link" quat="1 0 0 0" pos="0 0 0.1625">
        <inertial mass="3.7" pos="0 0 0" diaginertia="0.0102675 0.0102675 0.00666"/>
        <joint name="shoulder_pan_joint" class="size3" axis="0 0 1" />
        <geom name="shoulder_0" mesh="shoulder_0" material="urblue" class="visual" quat="0 0 0 1"/>
        <geom name="shoulder_1" mesh="shoulder_1" material="black" class="visual" quat="0 0 0 1"/>
        <geom name="shoulder_2" mesh="shoulder_2" material="jointgray" class="visual" quat="0 0 0 1"/>
        <geom class="collision" size="0.06 0.06" pos="0 0 -0.04" quat="0 0 0 1" rgba='0 0 1 0'/>

        <body name="upper_arm_link" pos="0 0 0" quat="1  1 -1  1">
          <!-- <inertial mass="8.393" pos="0.2125 0 0.138" diaginertia="0.133886 0.133886 0.0151074" quat='1 0 -1 0'/> -->
          <inertial mass="8.393" pos="0.2125 0 0.138" diaginertia="0.0151074 0.133886 0.133886 "/>
          <joint name="shoulder_lift_joint" class="size3" axis="0 0 1"/>
          <geom name="upperarm_0" mesh="upperarm_0" material="linkgray" class="visual" pos="0 0 0.138" quat='1 0 1 0'/>
          <geom name="upperarm_1" mesh="upperarm_1" material="black" class="visual" pos="0 0 0.138" quat='1 1 1 1'/>
          <geom name="upperarm_2" mesh="upperarm_2" material="jointgray" class="visual" pos="0 0 0.138" quat='1 1 1 1'/>
          <geom name="upperarm_3" mesh="upperarm_3" material="urblue" class="visual" pos="0 0 0.138" quat='1 1 1 1'/>
          <geom class="collision" pos="0 0 0.142" size="0.06 0.06" rgba='0 0 1 0' quat="1 0 0 0"/>
          <geom class="collision" pos="0.2125 0 0.138" size="0.05 0.2" rgba='0 0 1 0' quat='1 1 1 1'/>

          <body name="forearm_link" pos="0.4250 0 0" quat="1 0 0 0">
            <!-- <inertial mass="2.275" pos="0.196 0 0" diaginertia="0.0311796 0.0311796 0.004095" quat="1 0 1 0"/> -->
            <inertial mass="2.275" pos="0.196 0 0" diaginertia="0.004095 0.0311796 0.0311796"/>
            <joint name="elbow_joint" class="size3_limited" axis="0 0 1"/>
            <geom name="forearm_0" mesh="forearm_0" material="urblue" class="visual" quat="1 1 1 1" pos="0 0 0.007"/>
            <geom name="forearm_1" mesh="forearm_1" material="linkgray" class="visual" quat="1 0 1 0" pos="0 0 0.007"/>
            <geom name="forearm_2" mesh="forearm_2" material="black" class="visual" quat="1 1 1 1" pos="0 0 0.007"/>
            <geom name="forearm_3" mesh="forearm_3" material="jointgray" class="visual" quat="1 1 1 1" pos="0 0 0.007"/>
            <geom class="collision" size="0.055 0.06" pos="0 0 0.08" quat="1 0 0 0" rgba='0 0 1 0'/>
            <geom class="collision" size="0.038 0.19" pos="0.2 0 0.007"  quat="1 0 1 0" rgba='0 0 1 0'/>

            <!-- The original param for UR dh param was 0.1333, but the menajerie version used 0.127, which lines up with it's cad better... -->
            <body name="wrist_1_link" pos="0.3922 0 0.1333" quat="1 0 0 -1"> 
              <inertial mass="1.219" pos="0 0 0" diaginertia="0.0025599 0.0021942 0.0025599 "/> 
              <joint name="wrist_1_joint" class="size1" axis="0 0 1"/>
              <geom name="wrist1_0" mesh="wrist1_0" material="black" class="visual" quat="0 0 1 1" pos='0 0 -0.127'/>
              <geom name="wrist1_1" mesh="wrist1_1" material="urblue" class="visual" quat="0 0 1 1" pos='0 0 -0.127'/>
              <geom name="wrist1_2" mesh="wrist1_2" material="jointgray" class="visual" quat="0 0 1 1" pos='0 0 -0.127'/>
              <geom class="collision" pos="0 0 -0.0665" quat="1 0 0 0" size="0.04 0.07" rgba='0 0 1 0'/>

              <body name="wrist_2_link" pos="0 0.0997 0" quat="1 -1 0 0">
                <!-- <inertial mass="1.219" pos="0 0 0" diaginertia="0.0025599 0.0025599 0.0021942" quat="1 1 0 0"/> -->
                <inertial mass="1.219" pos="0 0 0" diaginertia="0.0025599 0.0021942 0.0025599 "/>
                <joint name="wrist_2_joint" axis="0 0 1" class="size1"/>
                <!-- <geom name="wrist2_0" mesh="wrist2_0" material="black" class="visual" pos="0 0.006 -0.0997" quat="0 0 0 -1"/> -->
                <!-- <geom name="wrist2_1" mesh="wrist2_1" material="urblue" class="visual" pos="0 0.006 -0.0997" quat="0 0 0 -1"/> -->
                <!-- <geom name="wrist2_2" mesh="wrist2_2" material="jointgray" class="visual" pos="0 0.006 -0.0997" quat="0 0 0 -1"/> -->

                <geom name="wrist2_0" mesh="wrist2_0" material="black" class="visual" pos="0 0 -0.0997" quat="0 0 0 -1"/>
                <geom name="wrist2_1" mesh="wrist2_1" material="urblue" class="visual" pos="0 0 -0.0997" quat="0 0 0 -1"/>
                <geom name="wrist2_2" mesh="wrist2_2" material="jointgray" class="visual" pos="0 0 -0.0997" quat="0 0 0 -1"/>

                <geom class="collision" size="0.04 0.06" pos="0 0 -0.06" rgba='0 0 1 0'/>
                <geom class="collision" pos="0 -0.01 0" quat="1 1 0 0" size="0.04 0.04" rgba='0 0 1 0'/>
                
                <body name="wrist_3_link" pos="0 0 0" quat="1 1 0 0">
                  <!-- <inertial mass="0.1889" pos="0 0 0.0771683" quat="1 0 1 0" diaginertia="0.000132134 9.90863e-05 9.90863e-05"/> -->
                  <inertial mass="0.1889" pos="0 0 0.0771683" diaginertia="9.90863e-05 9.90863e-05 0.000132134"/>
                  <joint name="wrist_3_joint" class="size1" axis="0 0 1"/>
                  <geom name="wrist3" material="linkgray" mesh="wrist3" class="visual" pos="0 0 0" quat="1 1 0 0"/>
                  <geom class="eef_collision" pos="0 0 0.08" quat="1 0 0 0" size="0.04 0.02" rgba='0 0 1 0'/>
                  <!-- <site name="ee_attachment_site" pos="0 0 0.0996" rgba='0 0 1 1'/> -->

                  <body name="dummy_body" pos="0 0 0.1250" >
                        
                    <body name="interface_attachment_body" pos="0 0 0" >
                      <geom name="spring" class='visual' type="cylinder" pos="0 0 -0.041" size=".020 .04" rgba='0.5 0.5 0.1 1' mass='0' conaffinity="0" contype="0"/>
                      <site name="distal_interface_site" pos="0 0 0" size="0.003" rgba='1 0 0 1' group='0'/>
                        
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

  </worldbody>

  <actuator>
    <general class="size3" name="shoulder_pan" joint="shoulder_pan_joint" forcelimited='true' />
    <general class="size3" name="shoulder_lift" joint="shoulder_lift_joint" forcelimited='true' />
    <general class="size3_limited" name="elbow" joint="elbow_joint" forcelimited='true' />
    <general class="size1" name="wrist_1" joint="wrist_1_joint" forcelimited='true' />
    <general class="size1" name="wrist_2" joint="wrist_2_joint" forcelimited='true' />
    <general class="size1" name="wrist_3" joint="wrist_3_joint" forcelimited='true' />
  </actuator>

  <sensor>
    <force site="distal_interface_site"/>
    <torque site="distal_interface_site"/>
    <velocimeter site="distal_interface_site"/>
    <gyro site="distal_interface_site"/>
  </sensor>

  <keyframe>
    <key name="home" qpos="-1.5708 0 -1.5000 -1.6416 -1.5708 1.5708" ctrl="0 0 0 0 0 0"/>
  </keyframe>
</mujoco>
